{
  "name": "sizely",
  "version": "0.1.1",
  "description": "Stop rejecting uploads. Fix them. Declarative file rules that validate AND auto-fix files in the browser before upload.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "require": "./dist/pdf.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "upload",
    "file",
    "validation",
    "image",
    "compress",
    "resize",
    "pdf",
    "browser",
    "client-side",
    "react",
    "nextjs",
    "passport-photo",
    "zod",
    "pdf-compression",
    "compress-pdf"
  ],
  "author": "educls",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/educls/sizely.git"
  },
  "bugs": {
    "url": "https://github.com/educls/sizely/issues"
  },
  "homepage": "https://github.com/educls/sizely#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@cantoo/pdf-lib": ">=2.4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@cantoo/pdf-lib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@types/react": "^19.3.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
