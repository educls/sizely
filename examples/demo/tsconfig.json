{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "sizely": ["../../src/index.ts"],
      "sizely/react": ["../../src/react.ts"],
      "sizely/pdf": ["../../src/pdf/index.ts"],
      "sizely/presets": ["../../src/presets.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
